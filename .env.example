# Supabase — lấy tại: Project Settings > API
# Copy file này thành `.env` rồi điền giá trị thật.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key

# Web Push — VAPID public key (sinh bằng: npx web-push generate-vapid-keys)
# Private key KHÔNG để đây — set làm secret của Edge Function.
VITE_VAPID_PUBLIC_KEY=
